# Copy this file to .env and edit values. Never commit .env to Git.
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=
CONTROL_ROOM_BASE_URL=
CONTROL_ROOM_API_KEY=demo-control-room-key
MOCK_CONTROL_ROOM=true
# Replace each demo password with a unique value before using this configuration.
HOSPITAL1_USERNAME=hospital1
HOSPITAL1_PASSWORD=change-this-password-1
HOSPITAL2_USERNAME=hospital2
HOSPITAL2_PASSWORD=change-this-password-2
HOSPITAL3_USERNAME=hospital3
HOSPITAL3_PASSWORD=change-this-password-3
HOSPITAL4_USERNAME=hospital4
HOSPITAL4_PASSWORD=change-this-password-4
HOSPITAL5_USERNAME=hospital5
HOSPITAL5_PASSWORD=change-this-password-5
HOSPITAL6_USERNAME=hospital6
HOSPITAL6_PASSWORD=change-this-password-6
HOSPITAL7_USERNAME=hospital7
HOSPITAL7_PASSWORD=change-this-password-7
HOSPITAL8_USERNAME=hospital8
HOSPITAL8_PASSWORD=change-this-password-8
HOSPITAL9_USERNAME=hospital9
HOSPITAL9_PASSWORD=change-this-password-9
HOSPITAL10_USERNAME=hospital10
HOSPITAL10_PASSWORD=change-this-password-10
HOSPITAL11_USERNAME=hospital11
HOSPITAL11_PASSWORD=change-this-password-11
HOSPITAL12_USERNAME=hospital12
HOSPITAL12_PASSWORD=change-this-password-12
# true  = backend reserves a bed automatically when an emergency arrives
# false = emergency stays INCOMING until hospital staff press Accept
AUTO_ACCEPT=true
HIGH_LOAD_THRESHOLD=80
CRITICAL_LOAD_THRESHOLD=90
